# Build output
/target/
*.pdb

# Prebuilt binaries — distribute via GitHub Releases, not the git history
# (a committed 100 MB exe bloats every clone). See the release workflow.
bin/*.exe

# Local architecture database and parse cache (regenerated per run)
.ovecc/

# Scratch logs and ad-hoc command output
*.log
export.json

# Local benchmark checkouts — large third-party clones, never committed.
# Measured results live in BENCHMARKS.md instead.
/benchmarks/

.github/workflows-example/

*.pdf
docs/local/
